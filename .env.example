# Скопируйте этот файл в .env и заполните. Сам .env в git не попадает.

# Адрес Keitaro без /admin на конце
KEITARO_URL=https://keitaro.example.com

# Ключ из админки Keitaro: Профиль -> API ключи
KEITARO_API_KEY=

# Префикс имён кампаний, добавляется автоматически
CAMPAIGN_PREFIX=test_ivanov_

# Домен, группа и источник новой кампании — по имени, как они называются в Keitaro
KEITARO_DOMAIN=tracker.example.com
KEITARO_GROUP=FORTESTS
KEITARO_SOURCE=FORTESTS

# Куда первый поток отправляет посетителей из выбранных стран
# GEO_REDIRECT_URL=https://google.com

# По умолчанию SQLite-файл рядом с проектом
# DATABASE_URL=sqlite:///./adrobot.db

# По каким именам хоста сервер отвечает (через запятую)
# ALLOWED_HOSTS=localhost,127.0.0.1
